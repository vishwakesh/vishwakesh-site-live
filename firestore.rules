rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      // Anyone can read a published post. A logged-in admin (you, via /admin)
      // can also read drafts, so the admin panel can list unpublished posts.
      allow read: if resource.data.published == true || request.auth != null;

      // Only a signed-in user can write. Since you're the only account with
      // login credentials (created manually in the Firebase Console), this
      // effectively means only you.
      allow write: if request.auth != null;
    }
  }
}
